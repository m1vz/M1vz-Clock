<UserControl x:Class="M1vClock.App.Overlay.OverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ov="clr-namespace:M1vClock.App.Overlay"
             Focusable="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border Background="#C8000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="12,9">
    <Border.LayoutTransform>
      <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
    </Border.LayoutTransform>
    <StackPanel TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="12" TextElement.Foreground="#F5F5F5" MinWidth="150">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding FpsText}" FontSize="24" FontWeight="Bold" Visibility="{Binding ShowFps, Converter={StaticResource BoolToVisible}}" />
        <TextBlock Text=" FPS" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="0,0,12,4" Visibility="{Binding ShowFps, Converter={StaticResource BoolToVisible}}" />
        <TextBlock Text="{Binding FrameTimeText}" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="{Binding ShowFrameTime, Converter={StaticResource BoolToVisible}}" />
      </StackPanel>
      <TextBlock Text="{Binding LowText}" Foreground="#8C8C8C" Visibility="{Binding ShowLow, Converter={StaticResource BoolToVisible}}" />
      <ov:OverlayGraph Values="{Binding Graph}" Width="190" Height="30" Margin="0,6,0,4" HorizontalAlignment="Left"
                       Visibility="{Binding ShowGraph, Converter={StaticResource BoolToVisible}}" />
      <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" Foreground="#8C8C8C" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Footer}" Foreground="#6E6E6E" FontSize="10" Margin="0,5,0,0" Visibility="{Binding HasFooter, Converter={StaticResource BoolToVisible}}" />
    </StackPanel>
  </Border>
</UserControl>
