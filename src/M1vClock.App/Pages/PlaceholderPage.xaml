<UserControl x:Class="M1vClock.App.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <Border Style="{StaticResource Card}" Padding="24,48">
      <dc:EmptyState Icon="{Binding Descriptor.IconKey, Converter={StaticResource KeyToGeometry}}"
                     Title="{l:Text Placeholder.Title}" Message="{Binding Subtitle}" Footnote="{Binding Footnote}" />
    </Border>
  </dc:PageScaffold>
</UserControl>
