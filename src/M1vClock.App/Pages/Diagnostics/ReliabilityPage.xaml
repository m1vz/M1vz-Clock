<UserControl x:Class="M1vClock.App.Pages.Diagnostics.ReliabilityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:dg="clr-namespace:M1vClock.App.Pages.Diagnostics"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16"
                      Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problems}" TextWrapping="Wrap" />
      </ContentControl>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Diag.Events.Window}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding WindowLabels}" SelectedIndex="{Binding WindowIndex, Mode=TwoWay}" Width="320" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Diag.Events.Window}" />
        </StackPanel>
      </Border>

      <UniformGrid Columns="4" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Reliability.Index.Current}" Value="{Binding CurrentText}" Unit="{l:Text Diag.Reliability.Index.Scale}"
                       State="{Binding VerdictTone}" StateText="{Binding VerdictText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Reliability.Index.Lowest}" Value="{Binding LowestText}" Unit="{l:Text Diag.Reliability.Index.Scale}"
                       IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Reliability.Summary.Failures}" Value="{Binding FailuresText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Reliability.Summary.Changes}" Value="{Binding ChangesText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" Visibility="{Binding HasChart, Converter={StaticResource BoolToVisible}}">
        <StackPanel>
          <TextBlock Text="{l:Text Diag.Reliability.Chart.Title}" Style="{StaticResource Text.Headline}" Margin="0,0,0,8" />
          <dc:HistoryChart Height="200" Points="{Binding ChartPoints}" Markers="{Binding Markers}" Minimum="1" Maximum="10"
                           Guides="{x:Static dg:ReliabilityPageViewModel.Guides}" AutomationProperties.Name="{Binding ChartName}" />
          <TextBlock Text="{l:Text Diag.Reliability.Chart.Note}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="{l:Text Diag.Reliability.Records.Title}" Style="{StaticResource Section.Title}" Margin="0,8,0,12" />
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
        <DockPanel>
          <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowChanges, Mode=TwoWay}" VerticalAlignment="Center"
                           AutomationProperties.Name="{l:Text Diag.Reliability.ShowChanges}" />
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="{l:Text Diag.Reliability.ShowChanges}" Style="{StaticResource Text.Body}" />
            <TextBlock Text="{l:Text Diag.Reliability.ShowChanges.Detail}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock Text="{Binding HiddenText}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,12"
                 Visibility="{Binding HasHidden, Converter={StaticResource BoolToVisible}}" />
      <TextBlock Text="{l:Text Diag.Reliability.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
      <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource DiagnosticRowTemplate}" Focusable="False" />
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
