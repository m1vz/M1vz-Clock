<UserControl x:Class="M1vClock.App.Pages.Diagnostics.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16"
                      Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problems}" TextWrapping="Wrap" />
      </ContentControl>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <StackPanel Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{l:Text Diag.Logs.File}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding FileLabels}" SelectedIndex="{Binding FileIndex, Mode=TwoWay}" HorizontalAlignment="Left"
                                 AutomationProperties.Name="{l:Text Diag.Logs.File}" />
          </StackPanel>
          <TextBlock Text="{l:Text Diag.Logs.NoFiles}" Style="{StaticResource Text.Body}" Visibility="{Binding ShowNoFiles, Converter={StaticResource BoolToVisible}}" />
          <TextBlock Text="{l:Text Diag.Logs.Level}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding LevelLabels}" SelectedIndex="{Binding LevelIndex, Mode=TwoWay}" Width="460" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Diag.Logs.Level}" />
          <TextBox Style="{StaticResource Input.Text}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,0"
                   dc:Assist.Icon="{StaticResource Icon.Search}" dc:Assist.Placeholder="{l:Text Diag.Logs.Search}"
                   AutomationProperties.Name="{l:Text Diag.Logs.Search}" ToolTip="{l:Text Diag.Logs.Search}" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Diag.Logs.OpenFolder}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Diag.Logs.Copy}" Command="{Binding CopyCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Notice}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0"
                     Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,4" />
      <TextBlock Text="{Binding ShowingText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="4,0,0,12"
                 Visibility="{Binding HasShowing, Converter={StaticResource BoolToVisible}}" />
      <TextBlock Text="{l:Text Diag.Logs.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisible}}" />

      <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="92" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Subhead.Numeric}" VerticalAlignment="Top" />
                <dc:StateBadge Grid.Column="1" State="{Binding Tone}" Text="{Binding SeverityText}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Text.Subhead}" TextWrapping="Wrap">
                    <Run Text="{Binding Source, Mode=OneTime}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message, Mode=OneTime}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
