<UserControl x:Class="M1vClock.App.Pages.Diagnostics.EventsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16"
                      Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problems}" TextWrapping="Wrap" />
      </ContentControl>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Diag.Events.Window}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding WindowLabels}" SelectedIndex="{Binding WindowIndex, Mode=TwoWay}" Width="420" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Diag.Events.Window}" />
          <DockPanel Margin="0,16,0,0">
            <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowNoise, Mode=TwoWay}" VerticalAlignment="Center"
                             AutomationProperties.Name="{l:Text Diag.Events.ShowNoise}" />
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="{l:Text Diag.Events.ShowNoise}" Style="{StaticResource Text.Body}" />
              <TextBlock Text="{l:Text Diag.Events.ShowNoise.Detail}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <UniformGrid Columns="3" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Events.Summary.Critical}" Value="{Binding CriticalText}" Detail="{Binding KindsText}"
                       State="{Binding CriticalState}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Events.Summary.Error}" Value="{Binding ErrorText}" State="{Binding ErrorState}"
                       IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Events.Summary.Warning}" Value="{Binding WarningText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <TextBlock Text="{Binding HiddenText}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,12"
                 Visibility="{Binding HasHidden, Converter={StaticResource BoolToVisible}}" />

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
        <TextBlock Text="{l:Text Diag.Events.Empty}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
      </Border>

      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" MinWidth="120" HorizontalAlignment="Right">
                  <dc:StateBadge State="{Binding Tone}" Text="{Binding SeverityText}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Headline.Numeric}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding LastText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisible}}" />
                  <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}" />
                  <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0" TextWrapping="Wrap">
                    <Run Text="{Binding LogText, Mode=OneTime}" /><Run Text=" · " /><Run Text="{Binding SourceText, Mode=OneTime}" />
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
