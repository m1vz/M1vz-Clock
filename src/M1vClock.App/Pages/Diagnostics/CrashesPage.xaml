<UserControl x:Class="M1vClock.App.Pages.Diagnostics.CrashesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16"
                      Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problems}" TextWrapping="Wrap" />
      </ContentControl>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Diag.Events.Window}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding WindowLabels}" SelectedIndex="{Binding WindowIndex, Mode=TwoWay}" Width="320" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Diag.Events.Window}" />
        </StackPanel>
      </Border>

      <UniformGrid Columns="3" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Crashes.Summary.BlueScreens}" Value="{Binding BlueScreensText}" State="{Binding BlueScreensState}"
                       IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Crashes.Summary.Shutdowns}" Value="{Binding ShutdownsText}" State="{Binding ShutdownsState}"
                       IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Diag.Crashes.Summary.Apps}" Value="{Binding AppCrashesText}" Detail="{Binding AppKindsText}"
                       IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <ContentControl Content="{Binding Settings}" ContentTemplate="{StaticResource InfoSectionTemplate}" />
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,-4,0,16" Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Advice}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Diag.Crashes.Shutdowns.Title}" Style="{StaticResource Section.Title}" Margin="0,8,0,12" />
      <TextBlock Text="{l:Text Diag.Crashes.Shutdowns.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding ShowShutdownsEmpty, Converter={StaticResource BoolToVisible}}" />
      <ItemsControl ItemsSource="{Binding Shutdowns}" ItemTemplate="{StaticResource DiagnosticRowTemplate}" Focusable="False" />

      <TextBlock Text="{l:Text Diag.Crashes.Apps.Title}" Style="{StaticResource Section.Title}" Margin="0,8,0,12" />
      <TextBlock Text="{l:Text Diag.Crashes.Apps.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding ShowAppsEmpty, Converter={StaticResource BoolToVisible}}" />
      <ItemsControl ItemsSource="{Binding AppCrashes}" ItemTemplate="{StaticResource DiagnosticRowTemplate}" Focusable="False" />

      <TextBlock Text="{l:Text Diag.Crashes.KernelDumps.Title}" Style="{StaticResource Section.Title}" Margin="0,8,0,12" />
      <TextBlock Text="{l:Text Diag.Crashes.KernelDumps.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding ShowKernelDumpsEmpty, Converter={StaticResource BoolToVisible}}" />
      <ItemsControl ItemsSource="{Binding KernelDumps}" ItemTemplate="{StaticResource DiagnosticRowTemplate}" Focusable="False" />

      <TextBlock Text="{l:Text Diag.Crashes.UserDumps.Title}" Style="{StaticResource Section.Title}" Margin="0,8,0,4" />
      <TextBlock Text="{l:Text Diag.Crashes.UserDumps.Hint}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,12" />
      <TextBlock Text="{l:Text Diag.Crashes.UserDumps.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding ShowUserDumpsEmpty, Converter={StaticResource BoolToVisible}}" />
      <ItemsControl ItemsSource="{Binding UserDumps}" ItemTemplate="{StaticResource DiagnosticRowTemplate}" Focusable="False" />
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
