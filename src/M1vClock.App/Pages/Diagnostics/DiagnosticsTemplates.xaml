<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls">

  <DataTemplate x:Key="DiagnosticRowTemplate">
    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" MinWidth="120" HorizontalAlignment="Right"
                    Visibility="{Binding HasTrailing, Converter={StaticResource BoolToVisible}}">
          <dc:StateBadge State="{Binding Tone}" Text="{Binding Badge}" HorizontalAlignment="Right" Margin="0,0,0,6"
                         Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisible}}" />
          <TextBlock Text="{Binding TrailingTop}" Style="{StaticResource Text.Headline.Numeric}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
          <TextBlock Text="{Binding TrailingBottom}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
        </StackPanel>
        <dc:StateBadge DockPanel.Dock="Right" State="{Binding Tone}" Text="{Binding Badge}" VerticalAlignment="Top" Margin="20,0,0,0"
                       Visibility="{Binding HasBadgeOnly, Converter={StaticResource BoolToVisible}}" />
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisible}}" />
          <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </DataTemplate>

</ResourceDictionary>
