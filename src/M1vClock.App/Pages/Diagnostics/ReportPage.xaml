<UserControl x:Class="M1vClock.App.Pages.Diagnostics.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Diag.Report.Collect}"
                Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Diag.Report.Copy}" Command="{Binding CopyCommand}" IsEnabled="{Binding CanExport}" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Primary}" Content="{l:Text Diag.Report.Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanExport}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Diag.Report.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Diag.Report.Include}" Style="{StaticResource Text.Headline}" Margin="0,0,0,8" />
          <TextBlock Text="{l:Text Diag.Report.Collecting}" Style="{StaticResource Text.Subhead.Secondary}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />
          <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,6" AutomationProperties.Name="{Binding AccessibleName}">
                  <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Include, Mode=TwoWay}" IsEnabled="{Binding HasData}" VerticalAlignment="Center"
                                   AutomationProperties.Name="{Binding Title}" />
                  <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
                    <TextBlock Text="{Binding RowsText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,12,0,0">
            <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IncludeName, Mode=TwoWay}" VerticalAlignment="Center"
                             AutomationProperties.Name="{l:Text Diag.Report.IncludeName}" />
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="{l:Text Diag.Report.IncludeName}" Style="{StaticResource Text.Body}" />
              <TextBlock Text="{l:Text Diag.Report.IncludeName.Detail}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{l:Text Diag.Report.Preview}" Style="{StaticResource Section.Title}" Margin="0,8,0,12" />
      <TextBlock Text="{l:Text Diag.Report.Preview.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding ShowNothingChosen, Converter={StaticResource BoolToVisible}}" />
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisible}}">
        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                 AutomationProperties.Name="{l:Text Diag.Report.Preview}" />
      </Border>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
