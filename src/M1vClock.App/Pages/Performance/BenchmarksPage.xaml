<UserControl x:Class="M1vClock.App.Pages.Performance.BenchmarksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:pf="clr-namespace:M1vClock.App.Pages.Performance"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <UserControl.Resources>
    <DataTemplate x:Key="BenchOptionTemplate" DataType="{x:Type pf:BenchOptionViewModel}">
      <StackPanel Margin="0,0,24,12">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
        <dc:SegmentedControl ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             Width="{Binding SegmentWidth}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Title}" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="HistoryRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.FillSubtle}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.FillPrimary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="HistoryRowTemplate" DataType="{x:Type pf:BenchHistoryRowViewModel}">
      <Grid Margin="0,2">
        <Button x:Name="RowButton" Style="{StaticResource HistoryRowButton}" Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                Margin="0,0,40,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="128" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Body}" />
              <TextBlock Style="{StaticResource Text.Subhead.Secondary}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding TestText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MachineText, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
            <dc:ProgressTrack Grid.Column="1" Fraction="{Binding Fraction}" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Style="{StaticResource Text.Body.Numeric}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Style="{StaticResource Button.Icon}" dc:Assist.Icon="{StaticResource Icon.Trash}" HorizontalAlignment="Right" VerticalAlignment="Center"
                Command="{Binding DeleteCommand}" CommandParameter="{Binding}" ToolTip="{l:Text Bench.History.Delete}"
                AutomationProperties.Name="{l:Text Bench.History.Delete}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBaseline}" Value="True">
          <Setter TargetName="RowButton" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Download}" Content="{l:Text Bench.Import.Button}"
                Command="{Binding ImportCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.External}" Content="{l:Text Bench.Export.Button}"
                Command="{Binding ExportCommand}" IsEnabled="{Binding IsIdle}" />
      </StackPanel>
    </dc:PageScaffold.Actions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top">
        <ListBox Style="{StaticResource List.Plain}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{l:Text Bench.Tests}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <dc:Icon DockPanel.Dock="Left" Data="{Binding IconKey, Converter={StaticResource KeyToGeometry}}" Size="16"
                         Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Column="2">
        <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding OtherTestRunning, Converter={StaticResource BoolToVisible}}">
          <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding OtherTestText}" />
        </ContentControl>
        <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasUnavailable, Converter={StaticResource BoolToVisible}}">
          <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding UnavailableText}" />
        </ContentControl>
        <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding MessageIsGood, Converter={StaticResource BoolToVisible}}">
          <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Message}" />
        </ContentControl>
        <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding MessageIsWarning, Converter={StaticResource BoolToVisible}}">
          <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Message}" />
        </ContentControl>
        <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16" Visibility="{Binding MessageIsCritical, Converter={StaticResource BoolToVisible}}">
          <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Message}" />
        </ContentControl>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{Binding ButtonText}" Command="{Binding ToggleCommand}"
                      IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="136" />
              <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.FillPrimary}" Margin="0,0,12,0">
                <dc:Icon Data="{Binding TestIconKey, Converter={StaticResource KeyToGeometry}}" Size="16" Foreground="{DynamicResource Brush.TextSecondary}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding TestTitle}" Style="{StaticResource Text.Headline}" />
                <TextBlock Text="{Binding TestDescription}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource BenchOptionTemplate}" Focusable="False" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Margin="0,4,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}">
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource Text.Subhead.Numeric}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Text.Subhead}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <dc:ProgressTrack Fraction="{Binding Progress}" />
              <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Subhead.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Visibility="{Binding HasProtectionText, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>

            <UniformGrid Columns="4" Margin="-8,16,-8,0" Visibility="{Binding ShowLive, Converter={StaticResource BoolToVisible}}">
              <dc:MetricCard Margin="8,0" DataContext="{Binding TemperatureCard}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                             State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
              <dc:MetricCard Margin="8,0" DataContext="{Binding LoadCard}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                             State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
              <dc:MetricCard Margin="8,0" DataContext="{Binding PowerCard}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                             State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
              <dc:MetricCard Margin="8,0" DataContext="{Binding ClockCard}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                             State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
            </UniformGrid>

            <Border Margin="0,16,0,0" Background="{DynamicResource Brush.FillPrimary}" CornerRadius="10" HorizontalAlignment="Left"
                    Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisible}}">
              <dc:RenderPreview Source="{Binding Preview}" MaxHeight="340" MaxWidth="620" />
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}">
          <StackPanel>
            <TextBlock Text="{Binding ScoreCaption}" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="{Binding ScoreHeadline}" Style="{StaticResource Text.Display.Numeric}" Margin="0,2,0,0" />
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSecondScore, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{Binding SecondScoreCaption}" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="{Binding SecondScoreHeadline}" Style="{StaticResource Text.Headline.Numeric}" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding VersusPrevious}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding HasVersus, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding Result}" ContentTemplate="{StaticResource InfoSectionTemplate}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}" />

        <ContentControl Content="{Binding Comparison}" ContentTemplate="{StaticResource InfoSectionTemplate}"
                        Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisible}}" />

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="{l:Text Bench.History.Title}" Style="{StaticResource Text.Headline}" />
            <TextBlock Text="{l:Text Bench.History.Hint}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,2,0,8" />
            <TextBlock Text="{l:Text Bench.History.Empty}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasHistory, Converter={StaticResource BoolToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding HistoryRows}" ItemTemplate="{StaticResource HistoryRowTemplate}" Focusable="False" />
            <Button Style="{StaticResource Button.Plain}" Content="{l:Text Bench.History.ShowMore}" Command="{Binding ShowMoreCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="{Binding CanShowMore, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </dc:PageScaffold>
</UserControl>
