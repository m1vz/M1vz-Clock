<UserControl x:Class="M1vClock.App.Pages.Performance.OverclockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16" Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>

      <TextBlock Text="{l:Text Oc.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <TextBlock Text="{l:Text Oc.Gpu.Heading}" Style="{StaticResource Text.Title}" Margin="4,0,0,8" />
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasGpuProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding GpuProblem}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasGpuResult, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding GpuResult}" TextWrapping="Wrap" />
      </ContentControl>
      <ItemsControl ItemsSource="{Binding Gpus}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" AutomationProperties.Name="{Binding Name}">
              <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Headline}" />
                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="200" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Subhead.Secondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <StackPanel Visibility="{Binding CanTune, Converter={StaticResource BoolToVisible}}" Margin="0,16,0,0">
                  <TextBlock Text="{l:Text Oc.Gpu.PowerField}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                  <TextBox Style="{StaticResource Input.Text}" Width="120" HorizontalAlignment="Left" Text="{Binding PowerText, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="{l:Text Oc.Gpu.PowerField}" />
                  <TextBlock Text="{l:Text Oc.Gpu.CapField}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
                  <dc:SegmentedControl ItemsSource="{Binding CapLabels}" SelectedIndex="{Binding CapIndex, Mode=TwoWay}" Width="560" HorizontalAlignment="Left"
                                       AutomationProperties.Name="{l:Text Oc.Gpu.CapField}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Oc.Gpu.Restore}" Margin="0,0,8,0"
                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{l:Text Oc.Gpu.Apply}"
                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{l:Text Oc.Check.Heading}" Style="{StaticResource Text.Title}" Margin="4,8,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Oc.Check.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <TextBlock Text="{l:Text Oc.Check.Target}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding TargetLabels}" SelectedIndex="{Binding TargetIndex, Mode=TwoWay}" Width="420" HorizontalAlignment="Left"
                               IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{l:Text Oc.Check.Target}" />
          <TextBlock Text="{l:Text Oc.Check.Duration}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding DurationLabels}" SelectedIndex="{Binding DurationIndex, Mode=TwoWay}" Width="300" HorizontalAlignment="Left"
                               IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{l:Text Oc.Check.Duration}" />
          <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{Binding CheckButtonText}" Command="{Binding ToggleCheckCommand}" Margin="16,0,0,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding CheckStatus}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" />
              <dc:ProgressTrack Fraction="{Binding CheckFraction}" Margin="0,6,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
          </DockPanel>
          <Border Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisible}}" Margin="0,16,0,0">
            <StackPanel>
              <dc:StateBadge State="{Binding VerdictTone}" Text="{Binding VerdictTitle}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <ItemsControl ItemsSource="{Binding VerdictReasons}" Margin="0,6,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Oc.Errors.Heading}" Style="{StaticResource Text.Headline}" />
          <TextBlock Text="{Binding ErrorsText}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{l:Text Oc.Errors.Tip}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding GuideTitle}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" Margin="4,8,0,4" />
      <TextBlock Text="{l:Text Oc.Bios.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,12" />
      <ItemsControl ItemsSource="{Binding Guide}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding Title}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Style="{StaticResource Text.Title}" Foreground="{DynamicResource Brush.TextTertiary}" Width="36" />
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Menu}" Style="{StaticResource Text.Body.Numeric}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding HasMenu, Converter={StaticResource BoolToVisible}}" />
                  <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
