<UserControl x:Class="M1vClock.App.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             xmlns:pages="clr-namespace:M1vClock.App.Pages"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <Button Content="{l:Text History.UndoAll.Button}" Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Undo}"
              Command="{Binding UndoAllCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
              Visibility="{Binding HasUndoable, Converter={StaticResource BoolToVisible}}" />
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner}" Margin="0,0,0,16"
                      Visibility="{Binding Feedback, Converter={StaticResource NullToCollapsed}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Feedback}" />
      </ContentControl>

      <Border Style="{StaticResource Card}" Padding="24,48" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
        <dc:EmptyState Icon="{StaticResource Icon.History}" Title="{l:Text History.Empty.Title}" Message="{l:Text History.Empty.Message}" />
      </Border>

      <Border Style="{StaticResource Card}" Padding="4" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToCollapsed}}">
        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:JournalEntryViewModel}">
              <Border Padding="16,12" CornerRadius="8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{l:Text History.Undo}" Style="{StaticResource Button.Plain}" VerticalAlignment="Center"
                          Command="{Binding UndoCommand}" CommandParameter="{Binding}" Margin="16,0,0,0"
                          Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisible}}" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Subhead.Secondary}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Critical}" TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good">
                  <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Positive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                  <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Critical">
                  <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Critical}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
