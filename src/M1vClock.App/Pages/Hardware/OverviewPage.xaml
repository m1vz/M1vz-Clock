<UserControl x:Class="M1vClock.App.Pages.Hardware.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:hw="clr-namespace:M1vClock.App.Pages.Hardware"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <UserControl.Resources>
    <DataTemplate x:Key="HealthRowTemplate" DataType="{x:Type hw:HealthRowViewModel}">
      <DockPanel Margin="0,7">
        <dc:Icon x:Name="Glyph" DockPanel.Dock="Left" Data="{Binding IconKey, Converter={StaticResource KeyToGeometry}}" Size="18"
                 Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Top" Margin="0,1,12,0" />
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Good">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Positive}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Warning">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Critical">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <StackPanel>
      <UniformGrid Columns="4" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" DataContext="{Binding Cpu}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                       State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" DataContext="{Binding Gpu}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                       State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" DataContext="{Binding Memory}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                       State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" DataContext="{Binding Disk}" Label="{Binding Label}" Value="{Binding Value}" Unit="{Binding Unit}" Detail="{Binding Detail}"
                       State="{Binding State}" StateText="{Binding StateText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <dc:SegmentedControl DockPanel.Dock="Right" Width="216" SelectedIndex="{Binding WindowIndex, Mode=TwoWay}" Margin="12,0,0,0"
                                 AutomationProperties.Name="{l:Text Hw.Overview.Chart.Window}">
              <dc:SegmentedItem Content="{l:Text Hw.Overview.Window.OneMinute}" />
              <dc:SegmentedItem Content="{l:Text Hw.Overview.Window.FiveMinutes}" />
              <dc:SegmentedItem Content="{l:Text Hw.Overview.Window.FifteenMinutes}" />
            </dc:SegmentedControl>
            <dc:SegmentedControl DockPanel.Dock="Right" Width="312" SelectedIndex="{Binding MetricIndex, Mode=TwoWay}"
                                 AutomationProperties.Name="{l:Text Hw.Overview.Chart.Metric}">
              <dc:SegmentedItem Content="{l:Text Hw.Overview.Chart.Temperature}" />
              <dc:SegmentedItem Content="{l:Text Hw.Overview.Chart.Load}" />
              <dc:SegmentedItem Content="{l:Text Hw.Overview.Chart.Power}" />
            </dc:SegmentedControl>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{l:Text Hw.Overview.Legend.Cpu}" Style="{StaticResource Text.Subhead}" Margin="0,0,16,0" />
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{l:Text Hw.Overview.Legend.Gpu}" Style="{StaticResource Text.Subhead}" />
            </StackPanel>
          </DockPanel>
          <dc:LiveChart Height="220" Primary="{Binding Primary}" Secondary="{Binding Secondary}" WindowSeconds="{Binding ChartWindowSeconds}"
                        Unit="{Binding ChartUnit}" ValueFormat="0" MinimumRange="{Binding ChartMinimumRange}" Floor="{Binding ChartFloor}" />
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="20,16" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <dc:StateBadge DockPanel.Dock="Right" State="{Binding HealthTone}" Text="{Binding HealthSummary}" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="{l:Text Hw.Overview.Health}" Style="{StaticResource Text.Headline}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Visibility="{Binding IsHealthLoading, Converter={StaticResource BoolToVisible}}" Margin="0,8,0,4">
              <Border Style="{StaticResource Skeleton}" Width="320" Height="14" Margin="0,6" HorizontalAlignment="Left" />
              <Border Style="{StaticResource Skeleton}" Width="240" Height="14" Margin="0,6" HorizontalAlignment="Left" />
              <Border Style="{StaticResource Skeleton}" Width="280" Height="14" Margin="0,6" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Text="{Binding HealthFailure}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap"
                       Visibility="{Binding HasHealthFailure, Converter={StaticResource BoolToVisible}}" />
            <ItemsControl ItemsSource="{Binding HealthRows}" ItemTemplate="{StaticResource HealthRowTemplate}" Focusable="False" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{l:Text Hw.Overview.Activity}" Style="{StaticResource Text.Headline}" Margin="0,0,0,8" />
            <TextBlock Text="{l:Text Hw.Overview.Activity.Empty}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap"
                       Visibility="{Binding HasActivity, Converter={StaticResource BoolToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding ActivityRows}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type hw:InfoRowViewModel}">
                  <StackPanel Margin="0,6">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
