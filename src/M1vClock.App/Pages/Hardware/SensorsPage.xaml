<UserControl x:Class="M1vClock.App.Pages.Hardware.SensorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:hw="clr-namespace:M1vClock.App.Pages.Hardware"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <UserControl.Resources>
    <DataTemplate x:Key="SensorRowTemplate" DataType="{x:Type hw:SensorRowViewModel}">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Subhead.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Subhead.Numeric}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Medium" TextAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Min}" Style="{StaticResource Text.Subhead.Numeric}" Foreground="{DynamicResource Brush.TextTertiary}" TextAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Max}" Style="{StaticResource Text.Subhead.Numeric}" Foreground="{DynamicResource Brush.TextTertiary}" TextAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SensorGroupTemplate" DataType="{x:Type hw:SensorGroupViewModel}">
      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.FillPrimary}" Margin="0,0,12,0">
              <dc:Icon Data="{Binding IconKey, Converter={StaticResource KeyToGeometry}}" Size="16" Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subhead.Secondary}" />
            </StackPanel>
          </DockPanel>
          <Grid Margin="0,4,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{l:Text Hw.Sensor.Col.Current}" Style="{StaticResource Text.Caption}" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{l:Text Hw.Sensor.Col.Min}" Style="{StaticResource Text.Caption}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{l:Text Hw.Sensor.Col.Max}" Style="{StaticResource Text.Caption}" TextAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SensorRowTemplate}" Focusable="False" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" Content="{Binding FreezeText}" Command="{Binding ToggleFreezeCommand}" MinWidth="104" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" />
          <TextBox Text="{Binding NoticeCommand, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,8,0,0" Padding="10,6"
                   Visibility="{Binding HasNoticeCommand, Converter={StaticResource BoolToVisible}}" AutomationProperties.Name="{l:Text Hw.Sensor.Problem.PawnIoCommand}" />
        </StackPanel>
      </ContentControl>

      <TextBox Style="{StaticResource Input.Text}" Height="40" Margin="0,0,0,12" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               dc:Assist.Icon="{StaticResource Icon.Search}" dc:Assist.Placeholder="{l:Text Hw.Sensor.Search}" AutomationProperties.Name="{l:Text Hw.Sensor.Search}" />
      <dc:SegmentedControl ItemsSource="{Binding FilterLabels}" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" Margin="0,0,0,16" HorizontalAlignment="Stretch" />

      <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisible}}" Margin="4,8,0,16">
        <TextBlock Text="{l:Text Hw.Sensor.Starting}" Style="{StaticResource Text.Subhead.Secondary}" Margin="0,0,0,12" />
        <Border Style="{StaticResource Skeleton}" Width="360" Height="14" Margin="0,6" HorizontalAlignment="Left" />
        <Border Style="{StaticResource Skeleton}" Width="280" Height="14" Margin="0,6" HorizontalAlignment="Left" />
        <Border Style="{StaticResource Skeleton}" Width="320" Height="14" Margin="0,6" HorizontalAlignment="Left" />
      </StackPanel>

      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{l:Text Hw.Sensor.Failed}" />
      </ContentControl>

      <TextBlock Text="{l:Text Hw.Sensor.NoMatch}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisible}}" />

      <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SensorGroupTemplate}" Focusable="False" />

      <TextBlock Text="{l:Text Hw.Sensor.Note.MinMax}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="4,0,0,0" />
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
