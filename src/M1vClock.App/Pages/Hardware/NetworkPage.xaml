<UserControl x:Class="M1vClock.App.Pages.Hardware.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>

      <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource InfoSectionTemplate}" Focusable="False" />

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" DataContext="{Binding Diagnostic}">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{Binding ButtonText}" Command="{Binding ToggleCommand}"
                    VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="136" />
            <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.FillPrimary}" Margin="0,0,12,0">
              <dc:Icon Data="{StaticResource Icon.Network}" Size="16" Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{l:Text Hw.Diag.Title}" Style="{StaticResource Text.Headline}" />
              <TextBlock Text="{l:Text Hw.Diag.Servers}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{l:Text Hw.Diag.Intro}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" />

          <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{Binding StageText}" Style="{StaticResource Text.Subhead.Secondary}" Margin="0,0,0,8" />
            <dc:ProgressTrack Fraction="{Binding Progress}" />
          </StackPanel>

          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,16,0,0"
                     Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
      </Border>

      <ContentControl Content="{Binding Diagnostic.Result}" ContentTemplate="{StaticResource InfoSectionTemplate}"
                      Visibility="{Binding Diagnostic.HasResult, Converter={StaticResource BoolToVisible}}" />
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
