<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
                    xmlns:hw="clr-namespace:M1vClock.App.Pages.Hardware"
                    xmlns:l="clr-namespace:M1vClock.App.Localization">

  <Style x:Key="Reveal.Button" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="dc:Assist.Icon" Value="{StaticResource Icon.Eye}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsRevealed}" Value="True">
        <Setter Property="dc:Assist.Icon" Value="{StaticResource Icon.EyeOff}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="InfoRowTemplate" DataType="{x:Type hw:InfoRowViewModel}">
    <Grid Margin="0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Subhead.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="{Binding Display}" Style="{StaticResource Text.Body.Numeric}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="2" Style="{StaticResource Reveal.Button}" Command="{Binding ToggleRevealCommand}"
              ToolTip="{Binding RevealToolTip}" AutomationProperties.Name="{Binding RevealToolTip}"
              Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisible}}" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="InfoSectionTemplate" DataType="{x:Type hw:InfoSectionViewModel}">
    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.FillPrimary}" Margin="0,0,12,0">
            <dc:Icon Data="{Binding IconKey, Converter={StaticResource KeyToGeometry}}" Size="16" Foreground="{DynamicResource Brush.TextSecondary}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" AutomationProperties.Name="{l:Text Hw.Common.Loading}" Margin="0,8,0,4">
          <Border Style="{StaticResource Skeleton}" Width="320" Height="14" Margin="0,6" />
          <Border Style="{StaticResource Skeleton}" Width="240" Height="14" Margin="0,6" />
          <Border Style="{StaticResource Skeleton}" Width="280" Height="14" Margin="0,6" />
          <Border Style="{StaticResource Skeleton}" Width="200" Height="14" Margin="0,6" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisible}}" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal">
            <dc:Icon Data="{StaticResource Icon.Error}" Size="16" Foreground="{DynamicResource Brush.Critical}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{l:Text Hw.Common.ReadError}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding ErrorDetail}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="24,4,0,12" />
          <Button Content="{l:Text Hw.Common.Retry}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="24,0,0,0"
                  dc:Assist.Icon="{StaticResource Icon.Refresh}" Command="{Binding RetryCommand}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource InfoRowTemplate}" Focusable="False"
                      Visibility="{Binding IsReady, Converter={StaticResource BoolToVisible}}" />
      </StackPanel>
    </Border>
  </DataTemplate>

</ResourceDictionary>
