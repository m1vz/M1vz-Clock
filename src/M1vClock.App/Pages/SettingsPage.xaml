<UserControl x:Class="M1vClock.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <StackPanel>
      <TextBlock Text="{l:Text Settings.Appearance}" Style="{StaticResource Section.Title}" Margin="0,0,0,12" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <DockPanel>
          <dc:SegmentedControl DockPanel.Dock="Right" Width="264" SelectedIndex="{Binding ThemeIndex}" VerticalAlignment="Center"
                               AutomationProperties.Name="{l:Text Settings.Theme}">
            <dc:SegmentedItem Content="{l:Text Settings.Theme.System}" />
            <dc:SegmentedItem Content="{l:Text Settings.Theme.Light}" />
            <dc:SegmentedItem Content="{l:Text Settings.Theme.Dark}" />
          </dc:SegmentedControl>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="{l:Text Settings.Theme}" Style="{StaticResource Text.Body}" />
            <TextBlock Text="{l:Text Settings.Theme.Detail}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="{l:Text Settings.About}" Style="{StaticResource Section.Title}" Margin="0,32,0,12" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Style="{StaticResource Text.Body.Numeric}" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="{l:Text Settings.About.Version}" Style="{StaticResource Text.Body}" />
          </DockPanel>
          <Border Style="{StaticResource Separator.Horizontal}" Margin="0,12" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ElevationText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="{l:Text Settings.About.Permission}" Style="{StaticResource Text.Body}" />
          </DockPanel>
          <Border Style="{StaticResource Separator.Horizontal}" Margin="0,12" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:Text Settings.About.OpenLogs}" Style="{StaticResource Button.Secondary}"
                    dc:Assist.Icon="{StaticResource Icon.Folder}" Command="{Binding OpenLogsCommand}" VerticalAlignment="Center" />
            <StackPanel Margin="0,0,24,0">
              <TextBlock Text="{l:Text Settings.About.Data}" Style="{StaticResource Text.Body}" />
              <TextBlock Text="{Binding DataRoot}" Style="{StaticResource Text.Subhead.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataRoot}" />
            </StackPanel>
          </DockPanel>
          <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,12,0,0"
                          Visibility="{Binding ActionError, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding ActionError}" />
          </ContentControl>
        </StackPanel>
      </Border>

      <TextBlock Text="{l:Text Settings.Privacy}" Style="{StaticResource Section.Title}" Margin="0,32,0,12" />
      <ContentControl Style="{StaticResource Banner}">
        <TextBlock Text="{l:Text Settings.Privacy.Text}" />
      </ContentControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
