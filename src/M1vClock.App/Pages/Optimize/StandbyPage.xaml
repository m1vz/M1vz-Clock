<UserControl x:Class="M1vClock.App.Pages.Optimize.StandbyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Opt.Memory.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <UniformGrid Columns="4" Margin="-8,0,-8,8">
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Memory.Total}" Value="{Binding TotalText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Memory.InUse}" Value="{Binding InUseText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Memory.Standby}" Value="{Binding StandbyText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Memory.Free}" Value="{Binding FreeText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>
      <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Text.Subhead}" Margin="4,8,0,0" />
      <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,2,0,16" />

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <Button Style="{StaticResource Button.Primary}" Content="{l:Text Opt.Memory.Action}" Command="{Binding PurgeCommand}" IsEnabled="{Binding CanPurge}" HorizontalAlignment="Left" />
          <TextBlock Text="{l:Text Opt.Memory.NeedsAdmin}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Visibility="{Binding NeedsAdministrator, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
