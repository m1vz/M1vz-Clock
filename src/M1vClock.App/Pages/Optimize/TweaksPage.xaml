<UserControl x:Class="M1vClock.App.Pages.Optimize.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Opt.Tweaks.Restore}" ToolTip="{l:Text Opt.Tweaks.Restore.Tip}" Margin="0,0,8,0"
                Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Opt.Tweaks.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,8" />
      <TextBlock Text="{Binding UserNote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <UniformGrid Columns="4" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Tweaks.Summary.Total}" Value="{Binding TotalText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Tweaks.Summary.On}" Value="{Binding OnText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Tweaks.Summary.Off}" Value="{Binding OffText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Tweaks.Summary.Changed}" Value="{Binding ChangedText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel>
                <DockPanel>
                  <dc:StateBadge DockPanel.Dock="Right" State="{Binding Tone}" Text="{Binding StateText}" VerticalAlignment="Top" Margin="20,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Effect}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding IssueText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasIssue, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisible}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="{Binding ActionText}" ToolTip="{Binding ActionToolTip}" HorizontalAlignment="Right" Margin="0,10,0,0"
                        IsEnabled="{Binding CanChange}"
                        Command="{Binding DataContext.ChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
