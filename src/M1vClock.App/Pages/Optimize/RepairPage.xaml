<UserControl x:Class="M1vClock.App.Pages.Optimize.RepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding NeedsAdministrator, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{l:Text Opt.Repair.NeedAdmin}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Opt.Repair.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{l:Text Opt.Repair.Cancel}" Margin="20,0,0,0" VerticalAlignment="Center"
                  Command="{Binding CancelCommand}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" />
            <dc:ProgressTrack Fraction="{Binding Fraction}" Margin="0,10,0,0" Visibility="{Binding HasFraction, Converter={StaticResource BoolToVisible}}" />
            <TextBlock Text="{Binding ProgressHint}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel>
                <DockPanel>
                  <dc:StateBadge DockPanel.Dock="Right" State="{Binding Tone}" Text="{Binding VerdictText}" VerticalAlignment="Top" Margin="20,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TookText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0"
                               Visibility="{Binding HasTook, Converter={StaticResource BoolToVisible}}" />
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisible}}" />
                <DockPanel Margin="0,8,0,0" Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisible}}">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{l:Text Opt.Repair.Copy}" Margin="12,0,0,0"
                          Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  <TextBox Text="{Binding Command, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Padding="10,6" AutomationProperties.Name="{l:Text Opt.Repair.Copy}" />
                </DockPanel>
                <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Opt.Repair.Run}" HorizontalAlignment="Right" Margin="0,10,0,0"
                        IsEnabled="{Binding DataContext.CanRun, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
