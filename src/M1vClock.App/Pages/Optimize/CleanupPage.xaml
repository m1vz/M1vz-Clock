<UserControl x:Class="M1vClock.App.Pages.Optimize.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Primary}" Content="{l:Text Opt.Cleanup.Action.CleanAll}" Command="{Binding CleanAllCommand}" IsEnabled="{Binding CanCleanAll}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Opt.Cleanup.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />
      <TextBlock Text="{l:Text Opt.Cleanup.Scanning}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />

      <UniformGrid Columns="3" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Cleanup.Summary.Total}" Value="{Binding TotalText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Cleanup.Summary.Files}" Value="{Binding FilesText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Cleanup.Summary.Places}" Value="{Binding PlacesText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" MinWidth="150" HorizontalAlignment="Right">
                  <dc:StateBadge State="{Binding Tone}" Text="{Binding Badge}" HorizontalAlignment="Right" Margin="0,0,0,8"
                                 Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisible}}" />
                  <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Headline.Numeric}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" />
                  <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Opt.Cleanup.Action.Clean}" ToolTip="{Binding ActionToolTip}" IsEnabled="{Binding CanClean}"
                          HorizontalAlignment="Right" Margin="0,10,0,0"
                          Command="{Binding DataContext.CleanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding UnreadableText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0"
                             Visibility="{Binding HasUnreadable, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
