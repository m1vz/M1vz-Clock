<UserControl x:Class="M1vClock.App.Pages.Optimize.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Opt.Apps.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <UniformGrid Columns="4" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Apps.Summary.Total}" Value="{Binding TotalText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Apps.Summary.Size}" Value="{Binding SizeText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Apps.Summary.Largest}" Value="{Binding LargestText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Opt.Apps.Summary.NoUninstaller}" Value="{Binding NoUninstallerText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Opt.Apps.Sort}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Width="320" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Opt.Apps.Sort}" />
          <TextBox Style="{StaticResource Input.Text}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,0"
                   dc:Assist.Icon="{StaticResource Icon.Search}" dc:Assist.Placeholder="{l:Text Opt.Apps.Search}"
                   AutomationProperties.Name="{l:Text Opt.Apps.Search}" ToolTip="{l:Text Opt.Apps.Search}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ShowingText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="4,0,0,12"
                 Visibility="{Binding HasShowing, Converter={StaticResource BoolToVisible}}" />
      <TextBlock Text="{l:Text Opt.Apps.Empty}" Style="{StaticResource Text.Subhead.Secondary}" Margin="4,0,0,16"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Headline}" HorizontalAlignment="Right" />
                  <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Opt.Apps.Uninstall}" Margin="0,10,0,0" HorizontalAlignment="Right"
                          IsEnabled="{Binding CanUninstall}" ToolTip="{Binding UninstallToolTip}"
                          Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisible}}" />
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
