<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:M1vClock.App.Navigation"
                    xmlns:pages="clr-namespace:M1vClock.App.Pages"
                    xmlns:hw="clr-namespace:M1vClock.App.Pages.Hardware"
                    xmlns:dg="clr-namespace:M1vClock.App.Pages.Diagnostics"
                    xmlns:op="clr-namespace:M1vClock.App.Pages.Optimize"
                    xmlns:pf="clr-namespace:M1vClock.App.Pages.Performance">

  <DataTemplate DataType="{x:Type nav:PlaceholderPageViewModel}">
    <pages:PlaceholderPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type hw:StoragePageViewModel}">
    <hw:StoragePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type hw:OverviewPageViewModel}">
    <hw:OverviewPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type hw:SensorsPageViewModel}">
    <hw:SensorsPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type hw:DevicesPageViewModel}">
    <hw:DevicesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type hw:NetworkPageViewModel}">
    <hw:NetworkPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type pf:BenchmarksPageViewModel}">
    <pf:BenchmarksPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type pf:StressPageViewModel}">
    <pf:StressPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type op:CleanupPageViewModel}">
    <op:CleanupPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type op:ServicesPageViewModel}">
    <op:ServicesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type op:StartupPageViewModel}">
    <op:StartupPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dg:ReportPageViewModel}">
    <dg:ReportPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dg:LogsPageViewModel}">
    <dg:LogsPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dg:ReliabilityPageViewModel}">
    <dg:ReliabilityPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dg:CrashesPageViewModel}">
    <dg:CrashesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dg:EventsPageViewModel}">
    <dg:EventsPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type hw:InfoPageViewModel}">
    <hw:InfoPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type pages:DesignSystemPageViewModel}">
    <pages:DesignSystemPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
    <pages:SettingsPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type pages:HistoryPageViewModel}">
    <pages:HistoryPage />
  </DataTemplate>

</ResourceDictionary>
