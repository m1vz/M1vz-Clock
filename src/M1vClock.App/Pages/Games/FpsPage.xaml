<UserControl x:Class="M1vClock.App.Pages.Games.FpsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Game.Fps.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <UniformGrid Columns="2" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Game.Fps.Machine.Cpu}" Value="{Binding CpuText}" Detail="{Binding CpuDetail}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Game.Fps.Machine.Gpu}" Value="{Binding GpuText}" Detail="{Binding GpuDetail}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Game.Fps.Resolution}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding ResolutionLabels}" SelectedIndex="{Binding ResolutionIndex, Mode=TwoWay}" Width="360" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Game.Fps.Resolution}" />
          <TextBlock Text="{l:Text Game.Fps.Preset}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding PresetLabels}" SelectedIndex="{Binding PresetIndex, Mode=TwoWay}" Width="420" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Game.Fps.Preset}" />
          <TextBlock Text="{l:Text Game.Fps.Upscaling}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding UpscalingLabels}" SelectedIndex="{Binding UpscalingIndex, Mode=TwoWay}" Width="420" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Game.Fps.Upscaling}" />
          <DockPanel Margin="0,16,0,0">
            <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding OnlyInstalled, Mode=TwoWay}" VerticalAlignment="Center"
                             AutomationProperties.Name="{l:Text Game.Fps.OnlyInstalled}" />
            <TextBlock Text="{l:Text Game.Fps.OnlyInstalled}" Style="{StaticResource Text.Subhead}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox Style="{StaticResource Input.Text}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,0"
                   dc:Assist.Icon="{StaticResource Icon.Search}" dc:Assist.Placeholder="{l:Text Game.Fps.Search}"
                   AutomationProperties.Name="{l:Text Game.Fps.Search}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Game.Fps.Key.Heading}" Style="{StaticResource Text.Headline}" Margin="0,0,0,6" />
          <TextBlock Text="{l:Text Game.Fps.Key.Intro}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Text="{Binding KeyStateText}" Style="{StaticResource Text.Subhead}" Margin="0,0,0,8" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Fps.Key.Save}" Command="{Binding SaveKeyCommand}" Margin="8,0,0,0" />
              <Button Style="{StaticResource Button.Plain}" Content="{l:Text Game.Fps.Key.Remove}" Command="{Binding RemoveKeyCommand}" Margin="8,0,0,0"
                      Visibility="{Binding HasKey, Converter={StaticResource BoolToVisible}}" />
              <Button Style="{StaticResource Button.Primary}" Content="{l:Text Game.Fps.Query}" ToolTip="{l:Text Game.Fps.Query.Tip}" Command="{Binding QueryCommand}"
                      IsEnabled="{Binding CanQuery}" Margin="8,0,0,0" />
            </StackPanel>
            <PasswordBox x:Name="KeyBox" Style="{StaticResource Input.Password}" PasswordChanged="OnKeyChanged"
                         AutomationProperties.Name="{l:Text Game.Fps.Key.Field}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{l:Text Game.Fps.Empty}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Width="200" Margin="16,0,0,0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding FpsText}" Style="{StaticResource Text.Display.Numeric}" FontSize="30" />
                    <TextBlock Text=" FPS" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                  </StackPanel>
                  <TextBlock Text="{Binding LowText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                  <dc:ProgressTrack Fraction="{Binding Bar}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
                    <dc:StateBadge State="{Binding Tone}" Text="{Binding RatingText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <dc:StateBadge State="Neutral" Text="{Binding InstalledText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisible}}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Genre}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
