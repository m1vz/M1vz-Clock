<UserControl x:Class="M1vClock.App.Pages.Games.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             xmlns:ov="clr-namespace:M1vClock.App.Overlay"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <Button Style="{StaticResource Button.Primary}" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" />
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasFramesNote, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding FramesNote}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Game.Overlay.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="20,16">
          <StackPanel>
            <TextBlock Text="{l:Text Game.Overlay.Corner}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding CornerLabels}" SelectedIndex="{Binding CornerIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="{l:Text Game.Overlay.Corner}" />
            <TextBlock Text="{l:Text Game.Overlay.Scale}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding ScaleLabels}" SelectedIndex="{Binding ScaleIndex, Mode=TwoWay}" Width="360" HorizontalAlignment="Left"
                                 AutomationProperties.Name="{l:Text Game.Overlay.Scale}" />
            <TextBlock Text="{l:Text Game.Overlay.Hotkey}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal">
              <TextBox Style="{StaticResource Input.Text}" Width="200" Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{l:Text Game.Overlay.Hotkey}" />
              <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Overlay.Hotkey.Apply}" Command="{Binding ApplyHotkeyCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="{l:Text Game.Overlay.Hotkey.Tip}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" MinWidth="280">
          <StackPanel>
            <TextBlock Text="{l:Text Game.Overlay.Preview}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
            <Border Background="#FF1A1F2B" CornerRadius="8" Padding="12" HorizontalAlignment="Left">
              <ov:OverlayPanel DataContext="{Binding Preview}" AutomationProperties.Name="{l:Text Game.Overlay.Preview}" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Button.Plain}" Content="{l:Text Game.Overlay.Preset.Minimal}" Command="{Binding UseMinimalCommand}" Margin="8,0,0,0" />
              <Button Style="{StaticResource Button.Plain}" Content="{l:Text Game.Overlay.Preset.Default}" Command="{Binding UseDefaultCommand}" Margin="8,0,0,0" />
              <Button Style="{StaticResource Button.Plain}" Content="{l:Text Game.Overlay.Preset.Everything}" Command="{Binding UseEverythingCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{l:Text Game.Overlay.Items}" Style="{StaticResource Text.Headline}" VerticalAlignment="Center" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,8,0,4">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                  <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,24,8">
                          <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                           AutomationProperties.Name="{Binding Label}" />
                          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Subhead}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
