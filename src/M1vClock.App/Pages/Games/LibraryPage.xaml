<UserControl x:Class="M1vClock.App.Pages.Games.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Library.Add}" ToolTip="{l:Text Game.Library.Add.Tip}" Margin="0,0,8,0"
                Command="{Binding AddGameCommand}" IsEnabled="{Binding IsBrowsing}" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16" Visibility="{Binding HasSession, Converter={StaticResource BoolToVisible}}"
              AutomationProperties.Name="{Binding SessionText}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Session.Stop}" ToolTip="{l:Text Game.Session.Stop.Tip}"
                  VerticalAlignment="Center" Margin="16,0,0,0" Command="{Binding StopSessionCommand}"
                  Visibility="{Binding SessionActive, Converter={StaticResource BoolToVisible}}" />
          <StackPanel>
            <TextBlock Text="{l:Text Game.Session.Heading}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding SessionText}" Style="{StaticResource Text.Subhead}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16" DataContext="{Binding Editor}">
          <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
            <TextBlock Text="{l:Text Game.Profile.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="0,6,0,16" />

            <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
              <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
            </ContentControl>
            <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
              <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
            </ContentControl>

            <TextBlock Text="{l:Text Game.Profile.Section.Launch}" Style="{StaticResource Text.Headline}" Margin="0,0,0,8" />
            <TextBlock Text="{l:Text Game.Profile.Engine}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding EngineLabels}" SelectedIndex="{Binding EngineIndex, Mode=TwoWay}" Width="480" HorizontalAlignment="Left"
                                 AutomationProperties.Name="{l:Text Game.Profile.Engine}" />
            <TextBlock Text="{Binding DetectedText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <TextBlock Text="{l:Text Game.Profile.Window}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding WindowModeLabels}" SelectedIndex="{Binding WindowModeIndex, Mode=TwoWay}" Width="480" HorizontalAlignment="Left"
                                 AutomationProperties.Name="{l:Text Game.Profile.Window}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{l:Text Game.Profile.Width}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Input.Text}" Width="110" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                         dc:Assist.Placeholder="1920" AutomationProperties.Name="{l:Text Game.Profile.Width}" />
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{l:Text Game.Profile.Height}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Input.Text}" Width="110" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                         dc:Assist.Placeholder="1080" AutomationProperties.Name="{l:Text Game.Profile.Height}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{l:Text Game.Profile.Refresh}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Input.Text}" Width="110" Text="{Binding RefreshText, UpdateSourceTrigger=PropertyChanged}"
                         dc:Assist.Placeholder="144" AutomationProperties.Name="{l:Text Game.Profile.Refresh}" />
              </StackPanel>
            </StackPanel>

            <TextBlock Text="{l:Text Game.Profile.Extra}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
            <TextBox Style="{StaticResource Input.Text}" Text="{Binding ExtraText, UpdateSourceTrigger=PropertyChanged}"
                     dc:Assist.Placeholder="-novid -high" AutomationProperties.Name="{l:Text Game.Profile.Extra}" />

            <TextBlock Text="{l:Text Game.Profile.Preview}" Style="{StaticResource Text.Caption}" Margin="0,16,0,4" />
            <TextBlock Text="{Binding Preview}" Style="{StaticResource Text.Body.Numeric}" TextWrapping="Wrap" AutomationProperties.Name="{l:Text Game.Profile.Preview}" />
            <TextBlock Text="{Binding ArgumentsNote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <StackPanel Visibility="{Binding IsSteam, Converter={StaticResource BoolToVisible}}" Margin="0,12,0,0">
              <TextBlock Text="{Binding SteamCurrentText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Profile.Steam.Write}" ToolTip="{l:Text Game.Profile.Steam.Write.Tip}"
                      HorizontalAlignment="Left" Command="{Binding WriteSteamCommand}" />
            </StackPanel>

            <TextBlock Text="{l:Text Game.Profile.Section.Windows}" Style="{StaticResource Text.Headline}" Margin="0,24,0,8" />
            <TextBlock Text="{l:Text Game.Profile.Priority}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding PriorityLabels}" SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}" Width="420" HorizontalAlignment="Left"
                                 AutomationProperties.Name="{l:Text Game.Profile.Priority}" />
            <DockPanel Margin="0,16,0,0">
              <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding HighPerformanceGpu, Mode=TwoWay}" VerticalAlignment="Center"
                               AutomationProperties.Name="{l:Text Game.Profile.Gpu}" />
              <StackPanel>
                <TextBlock Text="{l:Text Game.Profile.Gpu}" Style="{StaticResource Text.Subhead}" />
                <TextBlock Text="{l:Text Game.Profile.Gpu.Tip}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,16,0" />
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,12,0,0">
              <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding DisableFullscreenOptimizations, Mode=TwoWay}" VerticalAlignment="Center"
                               AutomationProperties.Name="{l:Text Game.Profile.Fso}" />
              <StackPanel>
                <TextBlock Text="{l:Text Game.Profile.Fso}" Style="{StaticResource Text.Subhead}" />
                <TextBlock Text="{l:Text Game.Profile.Fso.Tip}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,2,16,0" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{l:Text Game.Profile.Exe}" Style="{StaticResource Text.Caption}" Margin="0,16,0,4" />
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Plain}" Content="{l:Text Game.Profile.Exe.Clear}" Command="{Binding ClearExeCommand}" Margin="8,0,0,0"
                        Visibility="{Binding HasExe, Converter={StaticResource BoolToVisible}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Profile.Exe.Choose}" Command="{Binding PickExeCommand}" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Text="{Binding ExeText}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{l:Text Game.Profile.Exe.Tip}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="{l:Text Game.Profile.Section.Helpers}" Style="{StaticResource Text.Headline}" Margin="0,24,0,4" />
            <TextBlock Text="{l:Text Game.Profile.Helpers.Intro}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Helpers}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Plain}" Content="{l:Text Game.Profile.Helpers.Remove}" Margin="8,0,0,0"
                            Command="{Binding DataContext.RemoveHelperCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    <dc:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CloseWithGame, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0"
                                     ToolTip="{l:Text Game.Profile.Helpers.Close}" AutomationProperties.Name="{l:Text Game.Profile.Helpers.Close}" />
                    <TextBox DockPanel.Dock="Right" Style="{StaticResource Input.Text}" Width="200" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                             dc:Assist.Placeholder="{l:Text Game.Profile.Helpers.Args}" AutomationProperties.Name="{l:Text Game.Profile.Helpers.Args}" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Subhead}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Profile.Helpers.Add}" HorizontalAlignment="Left" Command="{Binding AddHelperCommand}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
              <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource Button.Primary}" Content="{l:Text Game.Profile.Save}" Command="{Binding SaveCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisible}}">
        <TextBlock Text="{l:Text Game.Library.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

        <UniformGrid Columns="4" Margin="-8,0,-8,16">
          <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Total}" Value="{Binding TotalText}" IsLoading="{Binding IsLoading}" />
          <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Size}" Value="{Binding SizeText}" IsLoading="{Binding IsLoading}" />
          <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Platforms}" Value="{Binding PlatformsText}" IsLoading="{Binding IsLoading}" />
          <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Attention}" Value="{Binding AttentionText}" IsLoading="{Binding IsLoading}" />
        </UniformGrid>

        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="{l:Text Game.Library.Filter}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding PlatformLabels}" SelectedIndex="{Binding PlatformIndex, Mode=TwoWay}" Width="680" HorizontalAlignment="Left"
                                 AutomationProperties.Name="{l:Text Game.Library.Filter}" />
            <TextBlock Text="{l:Text Game.Library.Sort}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
            <dc:SegmentedControl ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Width="240" HorizontalAlignment="Left"
                                 AutomationProperties.Name="{l:Text Game.Library.Sort}" />
            <TextBox Style="{StaticResource Input.Text}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,0"
                     dc:Assist.Icon="{StaticResource Icon.Search}" dc:Assist.Placeholder="{l:Text Game.Library.Search}"
                     AutomationProperties.Name="{l:Text Game.Library.Search}" ToolTip="{l:Text Game.Library.Search}" />
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding ShowingText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="4,0,0,12"
                   Visibility="{Binding HasShowing, Converter={StaticResource BoolToVisible}}" />
        <TextBlock Text="{l:Text Game.Library.Empty}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                      <dc:StateBadge State="Neutral" Text="{Binding ProfileBadge}" Margin="0,0,8,0"
                                     Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisible}}" />
                      <dc:StateBadge State="{Binding Tone}" Text="{Binding StateText}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Style="{StaticResource Button.Plain}" Content="{l:Text Game.Library.Remove}" Margin="0,0,8,0"
                            Visibility="{Binding IsManual, Converter={StaticResource BoolToVisible}}"
                            Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource Button.Secondary}" Content="{Binding ProfileText}" Margin="0,0,8,0"
                            Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Library.Folder}" ToolTip="{Binding FolderToolTip}" IsEnabled="{Binding CanOpenFolder}" Margin="0,0,8,0"
                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{l:Text Game.Library.Play}" ToolTip="{Binding PlayToolTip}" IsEnabled="{Binding CanPlay}"
                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
