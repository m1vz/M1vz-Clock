<UserControl x:Class="M1vClock.App.Pages.Games.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls"
             xmlns:l="clr-namespace:M1vClock.App.Localization"
             Focusable="False">
  <dc:PageScaffold Title="{Binding Title}" Subtitle="{Binding Subtitle}">
    <dc:PageScaffold.Actions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Style="{StaticResource Button.Secondary}" dc:Assist.Icon="{StaticResource Icon.Refresh}" Content="{l:Text Hw.Common.Refresh}"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </dc:PageScaffold.Actions>
    <StackPanel>
      <ContentControl Style="{StaticResource Banner.Critical}" Margin="0,0,0,16"
                      Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding PageError}" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Positive}" Margin="0,0,0,16" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Notice}" TextWrapping="Wrap" />
      </ContentControl>
      <ContentControl Style="{StaticResource Banner.Warning}" Margin="0,0,0,16" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource Banner.Text}" Text="{Binding Problem}" TextWrapping="Wrap" />
      </ContentControl>

      <TextBlock Text="{l:Text Game.Library.Intro}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16" />

      <UniformGrid Columns="4" Margin="-8,0,-8,16">
        <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Total}" Value="{Binding TotalText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Size}" Value="{Binding SizeText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Platforms}" Value="{Binding PlatformsText}" IsLoading="{Binding IsLoading}" />
        <dc:MetricCard Margin="8,0" Label="{l:Text Game.Library.Summary.Attention}" Value="{Binding AttentionText}" IsLoading="{Binding IsLoading}" />
      </UniformGrid>

      <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{l:Text Game.Library.Filter}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding PlatformLabels}" SelectedIndex="{Binding PlatformIndex, Mode=TwoWay}" Width="480" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Game.Library.Filter}" />
          <TextBlock Text="{l:Text Game.Library.Sort}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
          <dc:SegmentedControl ItemsSource="{Binding SortLabels}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Width="240" HorizontalAlignment="Left"
                               AutomationProperties.Name="{l:Text Game.Library.Sort}" />
          <TextBox Style="{StaticResource Input.Text}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,0"
                   dc:Assist.Icon="{StaticResource Icon.Search}" dc:Assist.Placeholder="{l:Text Game.Library.Search}"
                   AutomationProperties.Name="{l:Text Game.Library.Search}" ToolTip="{l:Text Game.Library.Search}" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ShowingText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="4,0,0,12"
                 Visibility="{Binding HasShowing, Converter={StaticResource BoolToVisible}}" />
      <TextBlock Text="{l:Text Game.Library.Empty}" Style="{StaticResource Text.Subhead.Secondary}" TextWrapping="Wrap" Margin="4,0,0,16"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel>
                <DockPanel>
                  <dc:StateBadge DockPanel.Dock="Right" State="{Binding Tone}" Text="{Binding StateText}" VerticalAlignment="Top" Margin="20,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                  <Button Style="{StaticResource Button.Secondary}" Content="{l:Text Game.Library.Folder}" ToolTip="{Binding FolderToolTip}" IsEnabled="{Binding CanOpenFolder}" Margin="0,0,8,0"
                          Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  <Button Style="{StaticResource Button.Primary}" Content="{l:Text Game.Library.Play}" ToolTip="{Binding PlayToolTip}" IsEnabled="{Binding CanPlay}"
                          Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </dc:PageScaffold>
</UserControl>
