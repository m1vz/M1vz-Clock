<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="clr-namespace:M1vClock.App.DesignSystem"
                    xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls">

  <ds:NullToCollapsedConverter x:Key="NullToCollapsed" />
  <ds:BoolToVisibilityConverter x:Key="BoolToVisible" />
  <ds:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
  <ds:ColorToBrushConverter x:Key="ColorToBrush" />
  <ds:ResourceKeyToGeometryConverter x:Key="KeyToGeometry" />

  <Style x:Key="Focus.Control">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderThickness="2" CornerRadius="10" SnapsToDevicePixels="True"
                  BorderBrush="{DynamicResource Brush.AccentForeground}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focus.Pill">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderThickness="2" CornerRadius="15" SnapsToDevicePixels="True"
                  BorderBrush="{DynamicResource Brush.AccentForeground}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focus.Inset">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="1" BorderThickness="2" CornerRadius="7" SnapsToDevicePixels="True"
                  BorderBrush="{DynamicResource Brush.AccentForeground}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Separator}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Skeleton" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.FillSkeleton}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Height" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="Separator.Horizontal" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Separator}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Subhead}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Control}" />
    <Setter Property="dc:PressFeedback.Scale" Value="0.97" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <dc:Icon x:Name="Glyph" Data="{TemplateBinding dc:Assist.Icon}" Size="16" VerticalAlignment="Center" Margin="0,0,8,0"
                       Visibility="{TemplateBinding dc:Assist.Icon, Converter={StaticResource NullToCollapsed}}" />
              <ContentPresenter x:Name="Label" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="Glyph" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.FillPrimaryHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.FillPrimaryPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Plain" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    <Setter Property="Padding" Value="8,0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.FillSubtle}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.FillPrimary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Destructive" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.CriticalFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.CriticalFillHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.CriticalFillPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.FillSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.FillPrimary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Large" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
  </Style>

  <Style x:Key="Input.Text" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.FillPrimary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <dc:Icon Data="{TemplateBinding dc:Assist.Icon}" Size="16" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Visibility="{TemplateBinding dc:Assist.Icon, Converter={StaticResource NullToCollapsed}}" />
              <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding dc:Assist.Placeholder}" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False" Visibility="Collapsed"
                         FontSize="{TemplateBinding FontSize}" />
              <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Subhead}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="1"
                  CornerRadius="8" Padding="10,6" MaxWidth="320">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{DynamicResource Brush.TextTertiary}" CornerRadius="3" Opacity="0.45" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollBar.Thumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Margin="2">
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="List.Row" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.FillSubtle}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="List.Plain" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource List.Row}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:ToggleSwitch">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="24" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:ToggleSwitch">
          <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Border CornerRadius="12" Background="{DynamicResource Brush.FillTrack}" BorderBrush="{DynamicResource Brush.ControlStroke}" BorderThickness="1" />
            <Border x:Name="PART_TrackOn" CornerRadius="12" Background="{DynamicResource Brush.Accent}" Opacity="0" />
            <Border x:Name="PART_Knob" Height="20" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#FFFFFF">
              <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.28" />
              </Border.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:SegmentedItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Subhead}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:SegmentedItem">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:SegmentedControl">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Height" Value="32" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:SegmentedControl">
          <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6" Background="{DynamicResource Brush.ControlThumb}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.12" />
                </Border.Effect>
              </Border>
              <ItemsPresenter />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:MetricCard">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:MetricCard">
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel LastChildFill="True">
                <Border x:Name="Badge" DockPanel.Dock="Right" CornerRadius="6" Padding="6,2" Visibility="Collapsed" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal">
                    <dc:Icon x:Name="BadgeIcon" Size="12" StrokeThickness="2" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BadgeText" Text="{TemplateBinding StateText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource Text.Subhead.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
              </DockPanel>
              <TextBlock x:Name="ValueText" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Text.Display.Numeric}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text=" " FontSize="{DynamicResource Size.Headline}" /><Run Text="{Binding Unit, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" FontFamily="{StaticResource Font.Text}" FontSize="{DynamicResource Size.Headline}" FontWeight="Normal" Foreground="{DynamicResource Brush.TextSecondary}" />
              </TextBlock>
              <StackPanel x:Name="Loading" Grid.Row="1" Margin="0,14,0,6" Visibility="Collapsed">
                <Border Style="{StaticResource Skeleton}" Width="104" Height="24" CornerRadius="6" />
              </StackPanel>
              <TextBlock x:Name="DetailText" Grid.Row="2" Margin="0,4,0,0" Text="{TemplateBinding Detail}" Style="{StaticResource Text.Subhead.Numeric}"
                         Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Detail" Value="">
              <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsLoading" Value="True">
              <Setter TargetName="ValueText" Property="Visibility" Value="Hidden" />
              <Setter TargetName="Loading" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="State" Value="Good">
              <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.PositiveSubtle}" />
              <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Icon.Success}" />
              <Setter TargetName="BadgeIcon" Property="Foreground" Value="{DynamicResource Brush.Positive}" />
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Positive}" />
            </Trigger>
            <Trigger Property="State" Value="Warning">
              <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
              <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Icon.Warning}" />
              <Setter TargetName="BadgeIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </Trigger>
            <Trigger Property="State" Value="Critical">
              <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.CriticalSubtle}" />
              <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Icon.Error}" />
              <Setter TargetName="BadgeIcon" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:StateBadge">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:StateBadge">
          <Border x:Name="Chip" CornerRadius="6" Padding="8,3" Background="{DynamicResource Brush.FillPrimary}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <dc:Icon x:Name="Glyph" Size="12" StrokeThickness="2" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                       Data="{StaticResource Icon.Info}" />
              <TextBlock x:Name="Label" Text="{TemplateBinding Text}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="State" Value="Good">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.PositiveSubtle}" />
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Success}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Positive}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Positive}" />
            </Trigger>
            <Trigger Property="State" Value="Warning">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </Trigger>
            <Trigger Property="State" Value="Critical">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.CriticalSubtle}" />
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Error}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:RingGauge">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Track" Value="{DynamicResource Brush.FillPrimary}" />
    <Setter Property="Width" Value="84" />
    <Setter Property="Height" Value="84" />
    <Style.Triggers>
      <Trigger Property="State" Value="Warning">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
      </Trigger>
      <Trigger Property="State" Value="Critical">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="dc:ProgressTrack">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Track" Value="{DynamicResource Brush.FillPrimary}" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <Style TargetType="dc:ToastCard">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:ToastCard">
          <Border Width="360" Margin="0,8,0,0" Padding="16,12" CornerRadius="12" BorderThickness="1"
                  Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Separator}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.2" />
            </Border.Effect>
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:EmptyState">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:EmptyState">
          <StackPanel MaxWidth="440" HorizontalAlignment="Center">
            <Border x:Name="IconWell" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.FillPrimary}" HorizontalAlignment="Center">
              <dc:Icon x:Name="Glyph" Data="{TemplateBinding Icon}" Size="24" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Headline}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" />
            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Body.Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Button x:Name="Action" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}" Style="{StaticResource Button.Secondary}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" />
            <TextBlock x:Name="FootnoteText" Text="{TemplateBinding Footnote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ActionText" Value="">
              <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Footnote" Value="">
              <Setter TargetName="FootnoteText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsError" Value="True">
              <Setter TargetName="IconWell" Property="Background" Value="{DynamicResource Brush.CriticalSubtle}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
