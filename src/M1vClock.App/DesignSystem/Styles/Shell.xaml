<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:M1vClock.App.DesignSystem.Controls">

  <Style x:Key="Sidebar.Item" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Subhead}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.FillSubtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SidebarSelection}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sidebar.Header" TargetType="Button">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,12,0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TitleBar.Search" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Width" Value="360" />
    <Setter Property="Padding" Value="10,0,6,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Control}" />
    <Setter Property="dc:PressFeedback.Scale" Value="0.98" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{DynamicResource Brush.FillSubtle}" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="1"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SidebarSelection}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Caption.Button" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.SystemIcons}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent">
            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.FillSubtle}" />
            </Trigger>
            <Trigger Property="dc:Assist.IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.FillSubtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SidebarSelection}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Caption.Close" TargetType="Button" BasedOn="{StaticResource Caption.Button}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent">
            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.CaptionCloseHover}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.CaptionCloseHover}" />
              <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
              <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="dc:PageScaffold">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="dc:PageScaffold">
          <Grid>
            <ScrollViewer x:Name="PART_Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel Margin="40,32,40,48" MaxWidth="1040">
                <DockPanel Margin="0,0,0,24">
                  <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Bottom" Margin="24,0,0,4" />
                  <StackPanel>
                    <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Display}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Text.Body.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
                <ContentPresenter />
              </StackPanel>
            </ScrollViewer>
            <Border x:Name="PART_Edge" VerticalAlignment="Top" Height="24" IsHitTestVisible="False" Opacity="0"
                    Background="{DynamicResource Brush.WindowBackground}">
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FF000000" Offset="0" />
                  <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Section.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Headline}">
    <Setter Property="Margin" Value="0,32,0,4" />
  </Style>

  <Style x:Key="Section.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Subhead.Secondary}">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Banner.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.Subhead}">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Banner" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    <Setter Property="dc:Assist.Icon" Value="{StaticResource Icon.Info}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10">
            <DockPanel>
              <dc:Icon DockPanel.Dock="Left" Data="{TemplateBinding dc:Assist.Icon}" Size="16" Foreground="{TemplateBinding Foreground}"
                       Margin="0,1,10,0" VerticalAlignment="Top" />
              <ContentPresenter TextElement.Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Banner.Positive" TargetType="ContentControl" BasedOn="{StaticResource Banner}">
    <Setter Property="Background" Value="{DynamicResource Brush.PositiveSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Positive}" />
    <Setter Property="dc:Assist.Icon" Value="{StaticResource Icon.Success}" />
  </Style>

  <Style x:Key="Banner.Warning" TargetType="ContentControl" BasedOn="{StaticResource Banner}">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    <Setter Property="dc:Assist.Icon" Value="{StaticResource Icon.Warning}" />
  </Style>

  <Style x:Key="Banner.Critical" TargetType="ContentControl" BasedOn="{StaticResource Banner}">
    <Setter Property="Background" Value="{DynamicResource Brush.CriticalSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
    <Setter Property="dc:Assist.Icon" Value="{StaticResource Icon.Error}" />
  </Style>

</ResourceDictionary>
