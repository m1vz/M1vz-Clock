<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="Font.Text">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Inter Display</FontFamily>
  <FontFamily x:Key="Font.SystemIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Body}" />
  </Style>

  <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Display}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Title}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{DynamicResource Size.Headline}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Headline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

  <Style x:Key="Text.Body.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style x:Key="Text.Subhead" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{DynamicResource Size.Subhead}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Subhead}" />
  </Style>

  <Style x:Key="Text.Subhead.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Subhead}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Caption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style x:Key="Text.Display.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Text.Headline.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Text.Headline}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Text.Body.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Text.Subhead.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Text.Subhead}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

</ResourceDictionary>
